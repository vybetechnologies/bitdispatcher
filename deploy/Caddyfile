# Caddy in front of bitdispatcher, mirroring upstream's deploy/demo/Caddyfile.
# Fly.io terminates public TLS at the edge and forwards plain HTTP here;
# the app itself only serves HTTPS, on loopback, with its own certificate.
:8080 {
	reverse_proxy https://127.0.0.1:8443 {
		# Live screens are a server-sent event stream: pass it through as it comes.
		flush_interval -1
		transport http {
			tls_insecure_skip_verify
		}
	}
}
